<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.github.sfesenko.whatsv</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>WhatsV</name>
  <summary>Simple Vala WhatsApp Web Client</summary>
  <description>
    <p>Simple Vala WhatsApp Web Client built with GTK 4 and WebKitGTK. Wraps web.whatsapp.com in a native window with persistent sessions, profiles and native hotkeys.</p>
    <p>Features: single-instance, per-profile isolated sessions (XDG data/cache), hardened WebKit settings, system notifications and download handling.</p>
  </description>

  <developer id="com.github.sfesenko">
    <name>Sergii Fesenko</name>
  </developer>

  <url type="homepage">https://github.com/sfesenko/whatsv</url>
  <url type="vcs-browser">https://github.com/sfesenko/whatsv</url>
  <url type="bugtracker">https://github.com/sfesenko/whatsv/issues</url>
  <url type="help">https://github.com/sfesenko/whatsv/wiki</url>
  <url type="faq">https://github.com/sfesenko/whatsv/wiki</url>

  <translation type="gettext">whatsv</translation>
  <launchable type="desktop-id">com.github.sfesenko.whatsv.desktop</launchable>
  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#25D366</color>
    <color type="primary" scheme_preference="dark">#128C7E</color>
  </branding>

  <releases>
    <release version="0.2.0" date="2026-08-24">
      <description>
        <p>Release 0.2.0</p>
      </description>
    </release>
    <release version="0.1.0" date="2025-06-28">
      <description>
        <p>Ukraine Constitution Day Release</p>
        <ul>
          <li>Initial release</li>
        </ul>
      </description>
    </release>
  </releases>

</component>
