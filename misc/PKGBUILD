# Maintainer: Sergii Fesenko <sergii_f@outlook.com>

pkgname=webapp-git
pkgver=2026.11.24
pkgrel=1
pkgdesc="Generic GTK Web App wrapper (default: WhatsApp Web)"
arch=('x86_64')
url="https://github.com/sfesenko/whatsv"
license=('MIT')
depends=('gtk4' 'webkitgtk-6.0' 'hicolor-icon-theme')
makedepends=('git' 'meson' 'ninja' 'vala' 'glib2' 'gtk4' 'webkitgtk-6.0')
provides=("${pkgname%-git}" 'whatsv')
conflicts=("${pkgname%-git}" 'whatsv-git')
source=()
sha256sums=()

# Builds from the local checkout containing this file. Set WEBAPP_SRC to
# build another checkout, and WEBAPP_SITE for another config (relative to
# the source root or absolute). The default site is the bundled WhatsApp
# sample; for a published package, copy this file and update the metadata.
_localdir="${WEBAPP_SRC:-$startdir/..}"
_localdir="$(realpath "$_localdir")"
_siteconf="${WEBAPP_SITE:-misc/whatsapp.conf}"

pkgver() {
  if git -C "${_localdir}" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "${_localdir}" log -1 --format='%cs' | tr '-' '.'
  else
    printf '%s\n' "${pkgver}"
  fi
}

build() {
  if [[ ! -f "${_localdir}/meson.build" ]]; then
    echo "WEBAPP_SRC (${_localdir}) is not a WebApp checkout" >&2
    return 1
  fi
  local site_path="${_siteconf}"
  [[ "${site_path}" = /* ]] || site_path="${_localdir}/${site_path}"
  if [[ ! -f "${site_path}" ]]; then
    echo "Site config not found: ${site_path}" >&2
    return 1
  fi
  meson setup --prefix=/usr "${srcdir}/build" "${_localdir}" -Dsite="${_siteconf}"
  meson compile -C "${srcdir}/build"
}

package() {
  meson install -C "${srcdir}/build" --destdir "${pkgdir}"
  install -Dm644 "${_localdir}/COPYING" "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
