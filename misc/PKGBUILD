# Maintainer: Sergii Fesenko <sergii_f@outlook.com>

pkgname=webapp-git
pkgver=2026.08.24
pkgrel=1
pkgdesc="Generic GTK Web App wrapper (default: WhatsApp Web)"
arch=('x86_64')
url="https://github.com/sfesenko/whatsv"
license=('MIT')
depends=('gtk4' 'webkitgtk-6.0' 'hicolor-icon-theme')
makedepends=('git' 'meson' 'ninja' 'vala' 'glib2' 'gtk4' 'webkitgtk-6.0')
provides=("${pkgname%-git}")
conflicts=("${pkgname%-git}")
source=("${pkgname}::git+https://github.com/sfesenko/whatsv.git")
sha256sums=('SKIP')
pkgver() {
  cd "${srcdir}/${pkgname}"
  git log -1 --format='%cs' | tr '-' '.'
}

build() {
  cd "${srcdir}"
  # A package for another site is a copy of this file with only pkgname and
  # the -Dsite path changed, for example:
  #   pkgname=webapp-other-git
  #   meson setup --prefix=/usr build "${srcdir}/${pkgname}" -Dsite="${srcdir}/${pkgname}/sites/other.conf"
  meson setup --prefix=/usr build "${srcdir}/${pkgname}" -Dsite="${srcdir}/${pkgname}/sites/whatsapp.conf"
  meson compile -C build
}

package() {
  meson install -C build --destdir "${pkgdir}"
  install -Dm644 "${srcdir}/${pkgname}/COPYING" "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
