# Maintainer: Sergii Fesenko <sergii underscore f dot at outlook dot com>

pkgname=whatsv-git
pkgver=2025.06.28
pkgrel=1
pkgdesc=" Simple Vala WhatsApp Web Client "
arch=('any')
url="https://github.com/sfesenko/whatsv"
license=('MIT')
depends=('gtk4' 'webkitgtk-6.0')
makedepends=('git' 'meson' 'vala')
provides=("${pkgname%-git}")
source=("${pkgname}::git+file://$PWD/..")
md5sums=('SKIP')
pkgver() {
  cd ${pkgname}
  # there is no tags, so use date of last commit
  git log -1 --format='%cs' | tr '-' '.'
}

build() {
  meson setup \
    --prefix /usr \
    _build ${pkgname}

  meson compile -C _build
}

package() {
  meson install -C _build --destdir ${pkgdir}
  # cd ${pkgname}
  # install -Dm755 antifennel ${pkgdir}/usr/bin/antifennel
  # install -Dm644 --target-directory=${pkgdir}/usr/share/licenses/${pkgname} LICENSE
}
